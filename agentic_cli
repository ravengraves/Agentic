#!/usr/bin/env python3
"""
Agentic CLI - minimal standalone terminal agent.
Reuses lib/ helpers for tool execution and Agentic.sublime-settings for config.
Python 3.8+, no f-strings, no type hints.
"""
import sys, os, time, json, re, argparse, urllib.error

from lib.agentic_tools import TOOLS, execute_tool
from lib.agentic_client import stream_chat
from lib.agentic_compaction import compact_history, copy_compaction_settings
from lib.agentic_markdown import (
    MarkdownContentEscaper,
    assistant_tool_message,
    format_chat,
    format_tool_block,
    parse_chat,
    tool_result_message,
)
from lib.agentic_project import apply_agents_md

CHARS_PER_TOKEN = 4

# -------------------------------------------------------------
#  Config loading
# -------------------------------------------------------------
def _parse_sublime_settings(path):
    if not os.path.isfile(path):
        return None
    try:
        with open(path) as f:
            raw = f.read()
        raw = re.sub(r'\s+//[^\n]*', '', raw)
        raw = re.sub(r',\s*([}\]])', r'\1', raw)
        cfg = json.loads(raw)
        if isinstance(cfg, dict):
            return cfg
    except Exception:
        pass
    return None

def _overlay_config(base, override):
    """Mimic Sublime settings lookup: user keys replace default keys."""
    cfg = dict(base or {})
    cfg.update(override or {})
    return cfg

def _load_config():
    # Try Sublime Text user packages directory (platform-specific) first
    home = os.path.expanduser("~")
    sublime_paths = [
        os.path.join(home, ".config", "sublime-text", "Packages", "User", "Agentic.sublime-settings"),
        os.path.join(home, "Library", "Application Support", "Sublime Text", "Packages", "User", "Agentic.sublime-settings"),
        os.path.join(os.environ.get("APPDATA", ""), "Sublime Text", "Packages", "User", "Agentic.sublime-settings"),
    ]
    local = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Agentic.sublime-settings")
    cfg = _parse_sublime_settings(local) or {}
    for sp in sublime_paths:
        user_cfg = _parse_sublime_settings(sp)
        if user_cfg:
            cfg = _overlay_config(cfg, user_cfg)
            break
    if cfg.get("models"):
        return cfg

    # Env fallback
    return {
        "default_prompt": os.environ.get("AGENTIC_PROMPT", "You are an expert coding agent. Take direct action using available tools."),
        "enable_agents_md": True,
        "default_models_compact": "models_low",
        "models_low": ["local"],
        "models": {
            "local": {
                "url": os.environ.get("AGENTIC_URL", "http://127.0.0.1:8080/v1/chat/completions"),
                "model": os.environ.get("AGENTIC_MODEL", "local-model"),
                "token": os.environ.get("AGENTIC_TOKEN", "000000000000"),
                "context": int(os.environ.get("AGENTIC_CONTEXT", "32768")),
                "options": {"stream": True, "temperature": 0.7},
                "tool_calling": True,
                "auto_compact": False,
            }
        },
    }

def chat_stream(messages, model, cancel=None, tools=None):
    return stream_chat(
        messages,
        model,
        cancel=cancel,
        tools=tools,
        user_agent="AgenticCLI/1.0")

def _select_model(config, model_name=None):
    models = config.get("models") or {}
    if not models:
        raise SystemExit("No models configured.")
    if model_name:
        if model_name not in models:
            available = ", ".join(sorted(models.keys()))
            raise SystemExit(
                "Unknown model '{}'. Available: {}".format(model_name, available))
        return model_name, dict(models[model_name])
    first_key = next(iter(models))
    return first_key, dict(models[first_key])

def _select_compact_model(config, fallback):
    models = config.get("models") or {}
    names = config.get(config.get("default_models_compact", "models_low")) or []
    for name in names:
        if name in models:
            compact = dict(models[name])
            compact["_compact_model_name"] = name
            return compact
    compact = dict(fallback or {})
    compact["_compact_model_name"] = "current"
    return compact

def _apply_config_to_model(model, config):
    if "auto_compact" in config:
        model["auto_compact"] = config["auto_compact"]
    model = copy_compaction_settings(model, config)
    model["_compact_model"] = copy_compaction_settings(
        _select_compact_model(config, model), config)
    return model

def _apply_agents_md(messages, config, cwd):
    return apply_agents_md(
        messages,
        cwd,
        enabled=config.get("enable_agents_md", True))

def _parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Agentic CLI - run an OpenAI-compatible local or remote model.")
    parser.add_argument(
        "--model",
        dest="model_name",
        help="Model settings key to use, e.g. openai-nano.")
    parser.add_argument(
        "--query",
        dest="query",
        help="Run one noninteractive query and exit.")
    parser.add_argument(
        "prompt",
        nargs="*",
        help="Prompt text. If present, runs once and exits.")
    return parser.parse_args(argv)

def _error_body(error):
    try:
        body = error.read().decode("utf-8", errors="replace").strip()
    except Exception:
        return ""
    if not body:
        return ""
    try:
        data = json.loads(body)
        if isinstance(data, dict):
            detail = data.get("error", data)
            if isinstance(detail, dict):
                return detail.get("message") or json.dumps(detail)
            return str(detail)
    except Exception:
        pass
    return body[:1000]

def _format_chat_error(error):
    if isinstance(error, urllib.error.HTTPError):
        msg = "HTTP {} {}".format(error.code, error.reason)
        body = _error_body(error)
        if body:
            msg += ": " + body
        return msg
    if isinstance(error, urllib.error.URLError):
        return "Network error: {}".format(error.reason)
    return "Streaming error: {}".format(error)

def _compact_history(messages, model):
    compact_model = model.get("_compact_model") or model
    def summarize(system_prompt, user_prompt):
        summary_text = ""
        compact_req = [
            {"role": "developer", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ]
        try:
            for chunk in chat_stream(compact_req, compact_model, tools=None):
                if isinstance(chunk, tuple) and len(chunk) == 2:
                    if not chunk[0]:
                        summary_text += chunk[1]
        except Exception:
            return ""
        return summary_text

    return compact_history(messages, compact_model, summarize)

# -------------------------------------------------------------
#  Agent loop
# -------------------------------------------------------------
def _run_agent(messages, model, cancel=None, max_rounds=10):
    tools = TOOLS  # CLI always uses tools
    had_error = False
    for _round in range(max_rounds):
        tool_calls = None
        streamed_content = ""
        streamed_reasoning = ""
        content_escaper = MarkdownContentEscaper()
        print("\n# --- Agent ---")
        try:
            for chunk in chat_stream(messages, model, cancel, tools=tools):
                if isinstance(chunk, tuple) and chunk[0] == "__tool_calls__":
                    tool_calls = chunk[1]
                    break
                if len(chunk) == 2:
                    is_reasoning, text = chunk
                    if is_reasoning:
                        streamed_reasoning += text
                    else:
                        streamed_content += text
                        sys.stdout.write(content_escaper.feed(text))
                        sys.stdout.flush()
                else:
                    break
                if cancel and cancel.is_set():
                    break
        except Exception as e:
            pending_content = content_escaper.flush()
            if pending_content:
                sys.stdout.write(pending_content)
                sys.stdout.flush()
            error_msg = _format_chat_error(e)
            print("\n[{}]".format(error_msg))
            messages.append({"role": "assistant", "content": "Error: " + error_msg})
            had_error = True
            break

        pending_content = content_escaper.flush()
        if pending_content:
            sys.stdout.write(pending_content)
            sys.stdout.flush()

        if had_error or (cancel and cancel.is_set()) or not tool_calls:
            break

        messages.append(assistant_tool_message(
            tool_calls,
            content=streamed_content.strip(),
            reasoning=streamed_reasoning.strip(),
        ))
        for tc in tool_calls:
            if cancel and cancel.is_set():
                break
            name = tc["function"]["name"]
            try:
                args = json.loads(tc["function"]["arguments"]) if isinstance(tc["function"]["arguments"], str) else (tc["function"]["arguments"] or {})
            except Exception:
                args = tc["function"]["arguments"]
            output, _ = execute_tool(name, args, cancel=cancel, session_id="cli")
            tool_msg = tool_result_message(tc, args, output)
            print("\n" + format_tool_block(
                tool_msg.get("tool_call_id", ""),
                tool_msg.get("name", ""),
                tool_msg.get("arguments", "{}"),
                tool_msg.get("content", ""),
            ))
            messages.append(tool_msg)

    # Auto-compact
    if model.get("auto_compact") and messages:
        est = sum(len(m.get("content", "")) for m in messages) // CHARS_PER_TOKEN
        if est > model.get("context", 32768) * 0.7:
            compact_name = model.get("_compact_model", {}).get(
                "_compact_model_name", "current")
            sys.stderr.write("Compaction starting with {}...\n".format(
                compact_name))
            sys.stderr.flush()
            compacted = _compact_history(messages, model)
            _print_compaction_result(messages, compacted, automatic=True)
            return compacted, had_error
    return messages, had_error

def _read_line(prompt):
    sys.stdout.write(prompt)
    sys.stdout.flush()
    line = sys.stdin.readline()
    return None if line == "" else line.rstrip("\n")

# -------------------------------------------------------------
#  Slash commands
# -------------------------------------------------------------
def _load_session(path, messages, config=None, cwd=None):
    with open(path, encoding="utf-8", errors="replace") as f:
        loaded = parse_chat(f.read())
    if loaded:
        if config is not None:
            _apply_agents_md(loaded, config, cwd or os.getcwd())
        messages[:] = loaded

def _print_messages(messages):
    """Print conversation in markdown format."""
    text = format_chat(messages)
    if text:
        print(text)
    print()

def _print_compaction_result(old_messages, new_messages, automatic=False):
    if new_messages == old_messages:
        print("[Context unchanged]")
        return False
    print("[Context compacted automatically]" if automatic else "[Context compacted]")
    _print_messages(new_messages)
    return True

def _handle_slash(cmd, messages, model, config, session_dir):
    parts = cmd.split(None, 1)
    op = parts[0].lower()
    arg = parts[1] if len(parts) > 1 else ""

    if op in ("/quit", "/q"):
        return True
    elif op == "/help":
        print("  /quit  /q      Exit")
        print("  /help          This help")
        print("  /new           New conversation (keep system prompt)")
        print("  /clear         Clear messages (same as /new)")
        print("  /compact       LLM-summarize older context")
        print("  /status        Show session info (model, tokens, turns)")
        print("  /save [name]   Save conversation to .Agentic/")
        print("  /load [name]   Load conversation from .Agentic/")
        print("  /model <name>  Switch model")
        print("  /system <text> Replace system prompt")
    elif op == "/new":
        messages[:] = [messages[0]]
        execute_tool("reset", {}, session_id="cli")
        print("[New conversation]")
    elif op == "/compact":
        compact_name = model.get("_compact_model", {}).get(
            "_compact_model_name", "current")
        sys.stderr.write("Compaction starting with {}...\n".format(
            compact_name))
        sys.stderr.flush()
        compacted = _compact_history(messages, model)
        if _print_compaction_result(messages, compacted):
            messages[:] = compacted
    elif op == "/model":
        models = config.get("models", {})
        if arg in models:
            model.clear()
            model.update(_apply_config_to_model(dict(models[arg]), config))
            print("[Model: {}]".format(arg))
        else:
            print("[Available models: {}]".format(", ".join(models.keys())))
    elif op == "/save":
        ts = time.strftime("%Y-%m-%d_%H-%M")
        name = ts + ("-" + arg if arg else "")
        path = os.path.join(session_dir, name + ".md")
        with open(path, "w", encoding="utf-8") as f:
            f.write(format_chat(messages))
            f.write("\n")
        print("[Saved to .Agentic/{}]".format(os.path.basename(path)))
    elif op == "/load":
        files = sorted([f for f in os.listdir(session_dir) if f.endswith(".md")],
                       key=lambda x: os.path.getmtime(os.path.join(session_dir, x)), reverse=True)
        if not arg:
            if not files:
                print("[No saved sessions in .Agentic/]")
            else:
                print("[Saved sessions (use /load <name> or /load <number>):]")
                for i, f in enumerate(files):
                    mtime = time.strftime("%m-%d %H:%M", time.localtime(os.path.getmtime(os.path.join(session_dir, f))))
                    print("  {}: {}  ({})".format(i+1, f[:-3], mtime))
        elif arg.isdigit():
            idx = int(arg) - 1
            if 0 <= idx < len(files):
                _load_session(os.path.join(session_dir, files[idx]), messages, config, os.getcwd())
                _print_messages(messages)
                print("[Loaded {}]".format(files[idx][:-3]))
            else:
                print("[Invalid session number. Use 1-{}]".format(len(files)))
        else:
            matches = [f for f in files if arg in f]
            if not matches:
                print("[No session matching '{}']".format(arg))
            elif len(matches) == 1:
                _load_session(os.path.join(session_dir, matches[0]), messages, config, os.getcwd())
                _print_messages(messages)
                print("[Loaded {}]".format(matches[0][:-3]))
            else:
                print("[Multiple matches (use /load <number>):]")
                for i, f in enumerate(matches):
                    print("  {}: {}".format(i+1, f[:-3]))
    elif op == "/system":
        messages[0]["content"] = arg
        print("[System prompt updated]")
    elif op == "/clear":
        messages[:] = [messages[0]]  # keep system msg
        execute_tool("reset", {}, session_id="cli")
        print("[Cleared]")
    elif op in ("/status", "/tokens"):
        est = sum(len(m.get("content", "")) for m in messages) // CHARS_PER_TOKEN
        ctx = model.get("context", 32768)
        pct = float(est) / ctx * 100
        turns = sum(1 for m in messages if m.get("role") in ("user", "assistant"))
        tools_called = sum(1 for m in messages if m.get("role") == "tool")
        print("  Model:    {} ({} tools)".format(model.get("model", "?"), len(TOOLS)))
        print("  Messages: {} ({}/{} turns, {} tools called)".format(len(messages), turns // 2, turns, tools_called))
        print("  Context:  {} / {} tokens ({:.0f}%)".format(est, ctx, pct))
        print("  Compact:  {}".format("on" if model.get("auto_compact") else "off"))
    else:
        print("[Unknown command: {}]".format(op))
    return False

# -------------------------------------------------------------
#  Main
# -------------------------------------------------------------
def main():
    args = _parse_args(sys.argv[1:])
    config = _load_config()
    model_key, model = _select_model(config, args.model_name)
    model = _apply_config_to_model(model, config)
    prompt = config.get("default_prompt", "You are an expert coding agent.")

    session_dir = os.path.join(os.getcwd(), ".Agentic")
    os.makedirs(session_dir, exist_ok=True)

    messages = [{"role": "developer", "content": prompt}]
    _apply_agents_md(messages, config, os.getcwd())

    print(format_chat([messages[0]]))
    print()
    print("Model: {} ({}) | Context: {} | Tools: {} | /help for commands\n".format(
        model_key, model.get("model"), model.get("context", "?"), len(TOOLS)))

    query = args.query
    if query is None and args.prompt:
        query = " ".join(args.prompt)

    if query:
        print("\n" + format_chat([{"role": "user", "content": query}]))
        messages.append({"role": "user", "content": query})
        print()
        try:
            messages, had_error = _run_agent(messages, model)
        except KeyboardInterrupt:
            print("\n[Interrupted]")
            return 130
        print()
        if had_error:
            return 1
        return 0

    try:
        while True:
            user_input = _read_line("> ")
            if user_input is None:
                break
            if not user_input.strip():
                continue
            if user_input.startswith("/"):
                if _handle_slash(user_input, messages, model, config, session_dir):
                    break
                continue

            # Collect multi-line input: read until blank line
            lines = [user_input]
            eof = False
            while True:
                line = _read_line("| ")
                if line is None:
                    eof = True
                    break
                if line.strip() == "":
                    break
                lines.append(line)
            if eof:
                break
            user_input = "\n".join(lines)

            print("\n" + format_chat([{"role": "user", "content": user_input}]))
            messages.append({"role": "user", "content": user_input})

            print()
            messages, had_error = _run_agent(messages, model)
            print()

            if had_error:
                print("[Request failed]")
    except KeyboardInterrupt:
        print("\n[Interrupted]")
        return 130
    finally:
        print("Goodbye.")
    return 0

if __name__ == "__main__":
    sys.exit(main())
